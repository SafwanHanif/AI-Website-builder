# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_website_builder

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider (groq, gemini, openai, claude, glm)
AI_PROVIDER=groq

# Groq Cloud
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (fallback — only needed if AI_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Supabase (client-side — for frontend)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend
BACKEND_CORS_ORIGINS=http://localhost:3000
